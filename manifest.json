{
  "manifest_version": 3,
  "name": "Stax — Tab Engine",
  "version": "1.2.0",
  "description": "Smart tab organization powered by regex rules and optional AI.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-sort": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+S"
      },
      "description": "Trigger Stax local tab sorting"
    }
  }
}
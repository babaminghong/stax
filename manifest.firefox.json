{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.4.0",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "quick-sort": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_cmdQuickSort__"
    },
    "quick-find": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open Stax quick tab search"
    },
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+D",
        "mac": "Command+Shift+D"
      },
      "description": "Toggle Stax focus mode"
    },
    "dedupe-tabs": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Command+Shift+X"
      },
      "description": "Close duplicate tabs"
    },
    "suspend-inactive": {
      "description": "Suspend inactive tabs"
    },
    "save-session": {
      "description": "Save current tabs as a session"
    },
    "archive-stale": {
      "description": "Archive stale tabs to Read Later"
    },
    "undo-last": {
      "description": "Undo the last Stax action"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stax@babaminghong.dev",
      "strict_min_version": "139.0"
    }
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Stax",
    "default_icon": {
      "32": "icons/icon32.png"
    }
  },
  "optional_permissions": [
    "sessions"
  ],
  "default_locale": "en"
}